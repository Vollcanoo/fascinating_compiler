// Trial division: dominated by multiply, remainder and loop-carried compares.
int main() {
  int count = 0;
  int n = 2;
  while (n < 10000) {
    int d = 2;
    int isp = 1;
    while (d * d <= n) {
      if (n % d == 0) {
        isp = 0;
        break;
      }
      d = d + 1;
    }
    if (isp == 1) count = count + 1;
    n = n + 1;
  }
  return count % 251;
}
